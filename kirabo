
#include <LiquidCrystal_I2C.h>
#include <ESP8266WiFi.h>
#include <PubSubClient.h>
#include <ArduinoJson.h>
#include <Wire.h>
#include <Keypad.h>

// ==========================
// WiFi
// ==========================
const char* ssid = "clusters";
const char* password = "1234567890@";

// ==========================
// MQTT
// ==========================
const char* mqttServer = "broker.hivemq.com";
const int mqttPort = 1883;

const char* topicLCD = "nit/lcd/14";
const char* topicBuzzer = "nit/buzzer/14";
const char* topicKeypad = "nit/keypad/14";

// ==========================
// Objects
// ==========================
WiFiClient espClient;
PubSubClient client(espClient);
LiquidCrystal_I2C lcd(0x27, 16, 2);

// ==========================
// Pins
// ==========================
const int buzzerPin = D1;  // FIXED

// ==========================
bool buzzerState = false;

// ==========================
// KEYPAD SETUP
// ==========================
const byte ROWS = 4;
const byte COLS = 4;

char keys[ROWS][COLS] = {
  {'1','2','3','A'},
  {'4','5','6','B'},
  {'7','8','9','C'},
  {'*','0','#','D'}
};

byte rowPins[ROWS] = {D0, D3, D4, D5};
byte colPins[COLS] = {D6, D7, D8, D2};

Keypad keypad = Keypad(makeKeymap(keys), rowPins, colPins, ROWS, COLS);

String inputText = "";

// ==========================
// WiFi connect
// ==========================
void connectWiFi() {
  Serial.print("Connecting WiFi");

  WiFi.begin(ssid, password);

  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }

  Serial.println("\nWiFi Connected!");
}

// ==========================
// Tone
// ==========================
void playTone() {
  tone(buzzerPin, 1000);
  delay(200);
  noTone(buzzerPin);
  delay(50);
}

// ==========================
// MQTT callback
// ==========================
void mqttCallback(char* topic, byte* payload, unsigned int length) {

  char message[length + 1];
  for (int i = 0; i < length; i++) {
    message[i] = payload[i];
  }
  message[length] = '\0';

  Serial.println(message);

  // LCD CONTROL
  if (strcmp(topic, topicLCD) == 0) {
    JsonDocument doc;
    deserializeJson(doc, message);
    const char* value = doc["value"];

    lcd.clear();
    lcd.setCursor(0,0);
    lcd.print(value);
  }

  // BUZZER CONTROL
  if (strcmp(topic, topicBuzzer) == 0) {
    JsonDocument doc;
    deserializeJson(doc, message);
    const char* state = doc["state"];

    if (strcmp(state, "on") == 0) {
      buzzerState = true;
    } else if (strcmp(state, "off") == 0) {
      buzzerState = false;
    }

    lcd.setCursor(0,1);
    lcd.print(buzzerState ? "Buzz: ON " : "Buzz: OFF");
  }
}

// ==========================
// MQTT connect
// ==========================
void connectMQTT() {
  while (!client.connected()) {

    String clientId = "mqtt_g14";
    clientId += String(ESP.getChipId(), HEX);

    if (client.connect(clientId.c_str())) {
      Serial.println("MQTT Connected");

      client.subscribe(topicLCD);
      client.subscribe(topicBuzzer);

    } else {
      delay(2000);
    }
  }
}

// ==========================
// KEYPAD FUNCTION
// ==========================
void handleKeypad() {
  char key = keypad.getKey();

  if (key) {
    Serial.println(key);

    if (key == '#') {
      client.publish(topicKeypad, inputText.c_str());

      lcd.clear();
      lcd.setCursor(0,0);
      lcd.print("Sent:");
      lcd.setCursor(0,1);
      lcd.print(inputText);

      inputText = "";
    }
    else if (key == '*') {
      inputText = "";
      lcd.clear();
      lcd.print("Cleared");
    }
    else {
      inputText += key;

      lcd.setCursor(0,0);
      lcd.print("Input:");
      lcd.setCursor(0,1);
      lcd.print(inputText);
    }
  }
}

// ==========================
// SETUP
// ==========================
void setup() {
  Serial.begin(115200);
  Wire.begin();

  pinMode(buzzerPin, OUTPUT);
  digitalWrite(buzzerPin, LOW);

  connectWiFi();

  client.setServer(mqttServer, mqttPort);
  client.setCallback(mqttCallback);

  lcd.init();
  lcd.backlight();
  lcd.print("Ready...");
}

// ==========================
// LOOP
// ==========================
void loop() {

  if (WiFi.status() != WL_CONNECTED) {
    connectWiFi();
  }

  if (!client.connected()) {
    connectMQTT();
  }

  client.loop();

  handleKeypad();   // 👈 keypad added

  if (buzzerState) {
    playTone();
  }
}
